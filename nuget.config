<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!--<clear />
    <add key="globalPackagesFolder" value="$\..\packages" />
    <add key="repositoryPath" value="$\..\packages" />-->
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- do not add new sources to this file. If new packages are required, push them to this feed. -->
    <add key="MUX-Dependencies" value="https://pkgs.dev.azure.com/shine-oss/microsoft-ui-xaml/_packaging/MUX-Dependencies/nuget/v3/index.json" />

  </packageSources>
  <packageSourceMapping>
    <packageSource key="MUX-Dependencies">
      <package pattern="MUXCustomBuildTasks" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <config>
    <!--<add key="repositoryPath" value="$\..\packages" />-->
  </config>
</configuration>